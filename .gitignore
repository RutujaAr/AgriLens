# ==========================================
# AgriLens - Git Ignore Configuration
# ==========================================

# Environment variables & secrets (CRITICAL)
.env
.env.local
.env.*.local
*.env

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Local SQLite databases
*.db
*.sqlite
*.sqlite3
backend/agrilens.db

# Uploaded cache files (keep directory structure)
backend/uploads/*
!backend/uploads/.gitkeep

# Node.js & Frontend build outputs
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
