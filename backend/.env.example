# ========================================================
# AgriLens Backend - Environment Configuration Template
# ========================================================
# Copy this file to .env in your backend directory or set these
# variables in your cloud provider's dashboard (e.g. Render, Railway).
# ========================================================

# Deployment environment: 'development' or 'production'
ENVIRONMENT=development

# Cryptographic Secret Key for JWT token signing (MUST be a random string >= 32 chars in production)
# Example production generation: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=agrilens-dev-secret-key-cse-minor-project-2026-auth-token

# Database Connection URL:
# Local SQLite default:
DATABASE_URL=sqlite:///agrilens.db
# Cloud Managed PostgreSQL example:
# DATABASE_URL=postgresql://postgres_user:postgres_password@db.render.com:5432/agrilens_prod

# Allowed CORS Origins (comma-separated list without trailing slashes)
# Development:
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
# Production example:
# ALLOWED_ORIGINS=https://agrilens.vercel.app,https://your-custom-domain.com

# Access token lifespan in minutes (1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Maximum dataset upload file size in bytes (52428800 = 50 MB)
MAX_UPLOAD_SIZE_BYTES=52428800

# Demo user initialization toggle:
# 'true' in development to auto-seed officer/farmer demo accounts.
# 'false' in production for standard public registration only.
ENABLE_DEMO_USERS=true
